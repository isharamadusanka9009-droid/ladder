<Window x:Class="LadderToArduino.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:LadderToArduino.Models"
        Title="Ladder to Arduino" Height="850" Width="1250" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ObjectDataProvider x:Key="ContactModes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters><x:Type TypeName="models:ContactMode"/></ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="AddressKinds" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters><x:Type TypeName="models:AddressKind"/></ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="CoilTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters><x:Type TypeName="models:CoilType"/></ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ComparatorOps" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters><x:Type TypeName="models:ComparatorOp"/></ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="AnalogSources" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters><x:Type TypeName="models:AnalogSource"/></ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <DockPanel>
        <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True">
            <Button Content="New Rung" Click="AddRung_Click" Padding="6,2" Margin="2"/>
            <Button Content="Paste Rung" Click="PasteRung_Click" Padding="6,2" Margin="2"/>
            <Button Content="Undo" Click="Undo_Click" Padding="6,2" Margin="2"/>
            <Button Content="Redo" Click="Redo_Click" Padding="6,2" Margin="2"/>
            <Separator/>
            <TextBlock Text="Board:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox x:Name="BoardCombo" Width="180" IsEditable="True" Margin="2"/>
            <TextBlock Text="Port:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <ComboBox x:Name="PortCombo" Width="90" Margin="2"/>
            <Button Content="Refresh Ports" Click="RefreshPorts_Click" Padding="6,2" Margin="2"/>
            <Separator/>
            <Button Content="Build Only" Click="BuildOnly_Click" Padding="6,2" Margin="2"/>
            <Button Content="Build &amp; Upload" Click="BuildUpload_Click" Padding="6,2" Margin="2" FontWeight="Bold"/>
            <Separator/>
            <Button Content="Export .ino" Click="ExportIno_Click" Padding="6,2" Margin="2"/>
            <Button Content="Save Project" Click="SaveProject_Click" Padding="6,2" Margin="2"/>
            <Button Content="Open Project" Click="OpenProject_Click" Padding="6,2" Margin="2"/>
        </ToolBar>

        <Grid DockPanel.Dock="Bottom" Height="150">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Log:" FontWeight="Bold" Margin="4,2"/>
            <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"/>
        </Grid>

        <TabControl>
            <!-- ===================== LADDER EDITOR ===================== -->
            <TabItem Header="Ladder Editor">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rungs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#444" BorderThickness="1" Margin="4" Padding="8" CornerRadius="3" Background="#F7F7F7">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                <Button Content="▲" Tag="{Binding}" Click="MoveRungUp_Click" Padding="6,1" Margin="2,0" ToolTip="Move up"/>
                                                <Button Content="▼" Tag="{Binding}" Click="MoveRungDown_Click" Padding="6,1" Margin="2,0" ToolTip="Move down"/>
                                                <Button Content="Copy" Tag="{Binding}" Click="CopyRung_Click" Padding="6,1" Margin="2,0"/>
                                                <Button Content="Delete Rung" Tag="{Binding}" Click="DeleteRung_Click" Padding="6,1" Margin="2,0"/>
                                                <Button Content="+ Branch" Tag="{Binding}" Click="AddBranch_Click" Padding="6,1" Margin="2,0"/>
                                                <Button Content="+ Output" Tag="{Binding}" Click="AddOutput_Click" Padding="6,1" Margin="2,0"/>
                                            </StackPanel>
                                            <TextBlock Text="Comment:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>

                                        <!-- branches -->
                                        <ItemsControl ItemsSource="{Binding Branches}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#CCC" BorderThickness="0,0,0,1" Padding="0,3">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="‖" FontWeight="Bold" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                                            <ItemsControl ItemsSource="{Binding Contacts}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border BorderBrush="Gray" BorderThickness="1" Margin="2" Padding="3" Background="White">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="--|" VerticalAlignment="Center"/>
                                                                                <ComboBox SelectedItem="{Binding Mode}" Width="90"
                                                                                          ItemsSource="{Binding Source={StaticResource ContactModes}}"
                                                                                          ToolTip="Ignored for AnalogInput (comparator inverts instead)"/>
                                                                                <ComboBox SelectedItem="{Binding Kind}" Width="65" Margin="2,0"
                                                                                          ItemsSource="{Binding Source={StaticResource AddressKinds}}"/>
                                                                                <TextBox Text="{Binding Index}" Width="26"/>
                                                                                <TextBlock Text="op:" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#888" FontSize="10"/>
                                                                                <ComboBox SelectedItem="{Binding Operator}" Width="55" Margin="2,0"
                                                                                          ItemsSource="{Binding Source={StaticResource ComparatorOps}}"
                                                                                          ToolTip="Only used when Kind = AnalogInput"/>
                                                                                <TextBox Text="{Binding Threshold}" Width="40" ToolTip="Threshold (only used when Kind = AnalogInput)"/>
                                                                                <TextBlock Text="|--" VerticalAlignment="Center" Margin="2,0"/>
                                                                                <Button Content="x" Tag="{Binding}" Click="DeleteContact_Click" Padding="3,0" Margin="2,0"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Content="+ Contact" Tag="{Binding}" Click="AddContact_Click" Padding="4,1" Margin="2,0" VerticalAlignment="Center"/>
                                                            <Button Content="Del Branch" Tag="{Binding}" Click="DeleteBranch_Click" Padding="4,1" Margin="6,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- outputs (multiple coils per rung) -->
                                        <ItemsControl ItemsSource="{Binding Outputs}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#999" BorderThickness="1" Margin="0,2" Padding="4" Background="#EFEFEF">
                                                        <WrapPanel>
                                                            <TextBlock Text="Output →" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                                                            <ComboBox SelectedItem="{Binding CoilType}" Width="120" Margin="2,0"
                                                                      ItemsSource="{Binding Source={StaticResource CoilTypes}}"/>
                                                            <ComboBox SelectedItem="{Binding OutputKind}" Width="65" Margin="2,0"
                                                                      ItemsSource="{Binding Source={StaticResource AddressKinds}}"/>
                                                            <TextBox Text="{Binding OutputIndex}" Width="30" Margin="2,0"/>

                                                            <TextBlock Text="Preset(ms/cnt):" VerticalAlignment="Center" Margin="10,0,2,0" FontSize="10" Foreground="#555"/>
                                                            <TextBox Text="{Binding Preset}" Width="55" Margin="2,0"/>

                                                            <TextBlock Text="Reset addr:" VerticalAlignment="Center" Margin="10,0,2,0" FontSize="10" Foreground="#555"
                                                                       ToolTip="Optional: force-resets a Timer/Counter. Set Reset Index to -1 for no reset."/>
                                                            <ComboBox SelectedItem="{Binding ResetKind}" Width="65" Margin="2,0"
                                                                      ItemsSource="{Binding Source={StaticResource AddressKinds}}"/>
                                                            <TextBox Text="{Binding ResetIndex}" Width="30" Margin="2,0" ToolTip="-1 = no reset wired"/>

                                                            <TextBlock Text="PWM src:" VerticalAlignment="Center" Margin="10,0,2,0" FontSize="10" Foreground="#555"
                                                                       ToolTip="Only used when Coil type = AnalogOutput"/>
                                                            <ComboBox SelectedItem="{Binding AnalogSource}" Width="130" Margin="2,0"
                                                                      ItemsSource="{Binding Source={StaticResource AnalogSources}}"/>
                                                            <TextBox Text="{Binding AnalogConstant}" Width="35" Margin="2,0" ToolTip="Constant 0-255 value"/>
                                                            <TextBox Text="{Binding AnalogSourceIndex}" Width="30" Margin="2,0" ToolTip="AI index to copy from"/>

                                                            <Button Content="x" Tag="{Binding}" Click="DeleteOutput_Click" Padding="4,0" Margin="8,0"/>
                                                        </WrapPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== PIN MAPPING ===================== -->
            <TabItem Header="Pin Mapping">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                        <Button Content="Add Pin Mapping" Click="AddPinMapping_Click" Padding="6,2"/>
                        <TextBlock Text="  Map every I / Q / AnalogInput(AI) / PWMOutput(AO) address you used to a real Arduino pin."
                                   VerticalAlignment="Center" Margin="8,0" Foreground="#555"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding PinMap}" AutoGenerateColumns="False" Margin="4" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Kind" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding Kind}" ItemsSource="{Binding Source={StaticResource AddressKinds}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="60"/>
                            <DataGridTextColumn Header="Arduino Pin #" Binding="{Binding Pin}" Width="110"/>
                            <DataGridCheckBoxColumn Header="INPUT_PULLUP" Binding="{Binding UseInternalPullup}" Width="110"/>
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete" Tag="{Binding}" Click="DeletePinMapping_Click" Padding="4,1"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== CROSS REFERENCE ===================== -->
            <TabItem Header="Cross Reference">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Refresh" Click="RefreshXRef_Click" Padding="6,2" Margin="4" HorizontalAlignment="Left"/>
                    <DataGrid x:Name="XRefGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="80"/>
                            <DataGridTextColumn Header="Used as contact in rung(s)" Binding="{Binding UsedAsContactIn}" Width="*"/>
                            <DataGridTextColumn Header="Used as coil in rung(s)" Binding="{Binding UsedAsCoilIn}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== SIMULATE ===================== -->
            <TabItem Header="Simulate">
                <DockPanel x:Name="SimPanel">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                        <Button Content="Load / Reset" Click="SimLoad_Click" Padding="6,2" Margin="2"/>
                        <Button Content="Step" Click="SimStep_Click" Padding="6,2" Margin="2"/>
                        <ToggleButton x:Name="SimRunToggle" Content="Run" Click="SimRunToggle_Click" Padding="10,2" Margin="2"/>
                        <TextBlock Text="  Runs the exact same logic as the generated sketch, entirely in the app - no Arduino needed."
                                   VerticalAlignment="Center" Margin="10,0" Foreground="#555"/>
                    </StackPanel>
                    <ScrollViewer>
                        <StackPanel Margin="6">
                            <TextBlock Text="Inputs (click to toggle I, type a value for AI)" FontWeight="Bold" Margin="0,4"/>
                            <WrapPanel>
                                <ItemsControl ItemsSource="{Binding SimInputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Content="{Binding Label}" IsChecked="{Binding Value}" Width="50" Margin="3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding SimAnalogInputs}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="3">
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Width="35"/>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Outputs Q" FontWeight="Bold" Margin="0,10,0,4"/>
                            <ItemsControl ItemsSource="{Binding SimOutputsQ}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="50" Height="26" Margin="3" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DDD"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Value}" Value="True">
                                                            <Setter Property="Background" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Memory M / Timers T / Counters C" FontWeight="Bold" Margin="0,10,0,4"/>
                            <ItemsControl ItemsSource="{Binding SimMemory}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="50" Height="26" Margin="3" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DDD"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Value}" Value="True">
                                                            <Setter Property="Background" Value="#2196F3"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="PWM Outputs (AO)" FontWeight="Bold" Margin="0,10,0,4"/>
                            <ItemsControl ItemsSource="{Binding SimAnalogOutputs}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="70" Height="26" Margin="3" Background="#EEE" CornerRadius="3">
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ===================== LIVE MONITOR ===================== -->
            <TabItem Header="Live Monitor">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                        <Button Content="Start Monitor" Click="MonitorStart_Click" Padding="6,2" Margin="2"/>
                        <Button Content="Stop Monitor" Click="MonitorStop_Click" Padding="6,2" Margin="2"/>
                        <TextBlock Text="  Reads the state the uploaded sketch prints over Serial. Close this before re-uploading (port can only be used by one program at a time)."
                                   VerticalAlignment="Center" Margin="10,0" Foreground="#555" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox x:Name="MonitorBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="4"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
